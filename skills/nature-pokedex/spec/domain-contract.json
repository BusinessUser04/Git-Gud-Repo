  "rules": [
    {
      "id": "R01",
      "statement": "Taxon and Encounter separate stable knowledge from observation facts."
    },
    {
      "id": "R02",
      "statement": "Confirmed canonical identity may resolve above species; unsupported ranks stay absent and probable candidates never create speculative canonical rows."
    },
    {
      "id": "R03",
      "statement": "Provisional narrower identity may coexist with a broader canonical taxon; clear only when resolved or superseded."
    },
    {
      "id": "R04",
      "statement": "Preserve aliases; display name alone is insufficient for taxon reconciliation; Life Group is not taxonomy."
    },
    {
      "id": "R05",
      "statement": "Event Key is dedicated, unique and independent of Ingest Batch, provider IDs and media."
    },
    {
      "id": "R06",
      "statement": "Same-key equal payload is a positive duplicate/no-op; a conflict is explicit; correction preserves event identity and useful history."
    },
    {
      "id": "R07",
      "statement": "Media byte identity is parsed SHA-256; filenames are provenance; the same media may support distinct events."
    },
    {
      "id": "R08",
      "statement": "Personal visual encounter is required for Seen; Photo/Video, heard-only or tracks alone do not establish it."
    },
    {
      "id": "R09",
      "statement": "Photo asserts owner-supplied or owner-produced encounter photography and establishes Photographed without binary storage or digest; generic identification images are outside this claim."
    },
    {
      "id": "R10",
      "statement": "Confirmed derives from supporting linked identity at actual rank; audio-only confirmation need not establish Seen or Photographed."
    },
    {
      "id": "R11",
      "statement": "First Seen is earliest supported owner encounter including nonvisual history; undated events require earliest-known-date qualification; corrections/relinks recompute affected taxa."
    },
    {
      "id": "R12",
      "statement": "Breed confidence is absent without a named breed/variety; phenotype does not prove pedigree or create canonical taxon/rating."
    },
    {
      "id": "R13",
      "statement": "Memorable and its reason are owner supplied; unmarked is not unimportant; owner wording stays separate from normalized facts."
    },
    {
      "id": "R14",
      "statement": "Power inputs are nullable integers 0..20; zero is valid; missing/invalid input yields diagnostics and Pending computed fields."
    },
    {
      "id": "R15",
      "statement": "Power v4 rounds the total once half-up; tier uses rounded score and no collection-relative adjustment."
    },
    {
      "id": "R16",
      "statement": "Computed score, computed tier, owner override and effective tier are distinct; override never changes score; S+ is override-only."
    },
    {
      "id": "R17",
      "statement": "Broad-rank ratings use labelled supported representative traits; broad rank alone does not force Pending; no composite exceptional relatives."
    },
    {
      "id": "R18",
      "statement": "Assessed ratings preserve model version, assessment date, per-axis reasoning, explicit estimates/uncertainty where relevant and targeted evidence for consequential uncertain claims; ordinary capture/replay reuses the current linked rating without rerating."
    },
    {
      "id": "R19",
      "statement": "Preserve unknown/date-only/instant semantics and supplied offset; D10 and mixed-precision ordering remain unresolved."
    },
    {
      "id": "R20",
      "statement": "Identification and persistence outcomes are independent; verified save requires commit and readback; retain returned IDs on uncertainty."
    },
    {
      "id": "R21",
      "statement": "Dry-run performs validation/resolution with zero writes; no-op requires positive match and no material delta."
    },
    {
      "id": "R22",
      "statement": "Corrections and added/conflicting evidence preserve event identity, useful correction history and recompute affected collection claims."
    },
    {
      "id": "R23",
      "statement": "Optional absent date, location, count, media or provenance cannot alone invalidate an encounter; count is positive whole visible units when supplied, never default one."
    },
    {
      "id": "R24",
      "statement": "Read-only integrity detection never automatically repairs, rerates or changes schema."
    },
    {
      "id": "R25",
      "statement": "Domain is provider-neutral; SQLite and PostgreSQL share semantics; Notion materialized values remain adapter concerns."
    },
    {
      "id": "R26",
      "statement": "Synthetic/generic fixtures only; no private history, locations, IDs/URLs, credentials, media or raw KB material."
    },
    {
      "id": "R27",
      "statement": "Reports project actual outcome, identity/rank, supported lineage, event facts and current linked rating read-only; failed/partial/no-op outcomes must not masquerade as saved captures."
    },
    {
      "id": "R28",
      "statement": "An authorized weight-change migration recomputes every populated adapter-stored score from authoritative inputs; invalid or missing inputs yield Pending diagnostics, never retained stale scores."
    },
    {
      "id": "R29",
      "statement": "Tier-band-only changes reinterpret tiers without rewriting stored scores or authoritative rating inputs."
    },
    {
      "id": "R30",
      "statement": "Adapter integrity validation checks the entire collection for stored-score drift against authoritative inputs and the active model; detection is read-only and repair requires separate authorization."
    }
  ]
}
